# Builds live outside the repo ($GRID_ENV_ROOT), but just in case
build/env/
*.lock
__pycache__/
# LaTeX
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
# Slurm stdout is kept (results/slurm) - it is evidence for the time-efficiency mark.
# ...but never drop job output under results/ (the LaTeX rules above would)
!results/**/*.out
!results/**/*.log
