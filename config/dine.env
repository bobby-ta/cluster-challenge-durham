# Environment for the ciuk-dine queue (DINE: 2x AMD EPYC 7302, 16c each, Zen 2, 512 GB).
# TODO(Tue AM): fix the module names after running slurm/recon.sbatch.
module purge
module load gnu_comp/14.1.0 || { echo "ERROR: gnu_comp/14.1.0 failed to load"; exit 1; }
module load likwid/5.5.1 || { echo "ERROR: likwid/5.5.1 failed to load"; exit 1; }   # needs a compiler loaded first; same version as dine2
module load openmpi 2>/dev/null || true    # TODO: confirm

export NODE_TAG=dine
export GRID_CONFIG="${GRID_CONFIG:-cpu-avx2}"  # allow per-job compiler tuning overrides
