# Environment for the ciuk-dine queue (DINE: 2x AMD EPYC 7302, 16c each, Zen 2, 512 GB).
# TODO(Tue AM): fix the module names after running slurm/recon.sbatch.
module purge
module load likwid 2>/dev/null || echo "WARN: no likwid module, set PATH to own install"
module load gnu_comp 2>/dev/null || true   # TODO: confirm COSMA compiler module name
module load openmpi 2>/dev/null || true    # TODO: confirm

export NODE_TAG=dine
export GRID_CONFIG=cpu-avx2                # entry in build/systems/cosma/grid-config.json
