# Environment for the ciuk-dine2 queue. CPU unknown until recon: check lscpu flags for
# avx512f and set GRID_CONFIG to cpu-avx512 if present.
module purge
module load likwid 2>/dev/null || echo "WARN: no likwid module, set PATH to own install"
module load gnu_comp 2>/dev/null || true   # TODO: confirm
module load openmpi 2>/dev/null || true    # TODO: confirm

export NODE_TAG=dine2
export GRID_CONFIG=cpu-avx2                # TODO(Tue AM): cpu-avx512 if supported
