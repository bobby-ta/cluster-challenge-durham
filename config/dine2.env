# Environment for the ciuk-dine2 queue (DINE2: 2x Intel Xeon Gold 6430, 32c each, Sapphire Rapids,
# AVX-512, 2 TB; from recon 12202559).
module purge
module load gnu_comp/14.1.0 || { echo "ERROR: gnu_comp/14.1.0 failed to load"; exit 1; }
module load likwid/5.5.1 || { echo "ERROR: likwid/5.5.1 failed to load"; exit 1; }   # needs a compiler loaded first; same version as dine
module load openmpi 2>/dev/null || true    # TODO: confirm

export NODE_TAG=dine2
export GRID_CONFIG="${GRID_CONFIG:-cpu-avx512}"  # allow per-job compiler tuning overrides
